# ==============================================================================
# BRAND BRIDGE - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with local development values.
# NEVER commit the active '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Runtime
# ------------------------------------------------------------------------------
# Options: development, test, staging, production
ENVIRONMENT=development
DEBUG=true
APP_NAME="Brand Bridge"
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Security / Session secret key (generate with: openssl rand -hex 32)
# Required in production; dev placeholder only
SECRET_KEY=change_this_to_a_secure_random_string_for_local_dev

# Allowed CORS origins (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Database connection parameters (to be configured in subsequent phases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brand_bridge_dev

# Full SQLAlchemy Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brand_bridge_dev

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Frontend Application Configuration (React / Vite / Next.js)
# ------------------------------------------------------------------------------
# Public API base URL accessed by the frontend client
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# AI / ML Service Configuration (Future Phases)
# ------------------------------------------------------------------------------
# Provider options: mock, openai, anthropic, local
AI_PROVIDER=mock
# Placeholder: replace with actual API key when enabling cloud LLM provider
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Storage & File Assets
# ------------------------------------------------------------------------------
# Options: local, s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/samples
MAX_UPLOAD_SIZE_MB=25
