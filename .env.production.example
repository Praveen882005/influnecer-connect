# ==============================================================================
# BRAND BRIDGE - Production Environment Configuration Reference
# ==============================================================================
# Copy this file to '.env' or enter these key-value pairs into your cloud host's
# Environment Variables dashboard (Render, Railway, Fly.io, Vercel, AWS ECS).
#
# CRITICAL SECURITY RULES:
#   1. NEVER commit '.env' or production credentials to Git or public repositories.
#   2. Generate strong, unique cryptographic secrets for SECRET_KEY.
#   3. Always set DEBUG=false and AUTO_CREATE_TABLES=false in production.
#   4. Use SSL/TLS for external managed database connections (?ssl=require).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_NAME="Brand Bridge"
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Sessions
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-character hex key with:
#   openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_randomly_generated_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Host & Networking
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
WEB_CONCURRENCY=2

# Comma-separated list of allowed origins (No trailing slashes).
# Replace with your actual custom domain or cloud hosting URLs.
# Example: https://brandbridge.app,https://www.brandbridge.app
CORS_ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# ------------------------------------------------------------------------------
# 4. Production Database Configuration (Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Supported: Supabase, Neon, Render Postgres, Railway Postgres, AWS RDS
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl=require
#
# Note: If your provider gives 'postgres://...' or 'postgresql://...', our alembic
# env.py and application automatically normalize it to 'postgresql+asyncpg://'.
DATABASE_URL=postgresql+asyncpg://postgres:YourSecureDbPassword@db.yourprovider.com:5432/brand_bridge?ssl=require

# Database Schema Migration Policy
# In production, schemas MUST be managed via Alembic (alembic upgrade head).
AUTO_CREATE_TABLES=false

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 5. Frontend Build Configuration (Vite)
# ------------------------------------------------------------------------------
# Set this during frontend build on Vercel, Netlify, or Render Static Sites.
# If frontend and backend share the same domain via Nginx proxy, set to: /api
# If deployed on a separate domain (e.g. backend.yourdomain.com), set to:
#   https://backend.yourdomain.com/api
VITE_API_URL=https://api.yourdomain.com/api

# ------------------------------------------------------------------------------
# 6. File & Media Storage Provider
# ------------------------------------------------------------------------------
# Options: 'local' (mounted persistent volume) or 's3' (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/data/samples
MAX_UPLOAD_SIZE_MB=25

# Optional AWS S3 Configuration (when STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=brand-bridge-production-assets

# ------------------------------------------------------------------------------
# 7. AI & Machine Learning Configuration
# ------------------------------------------------------------------------------
# Options: 'local' (offline TF-IDF & local embeddings) or 'openai' / 'anthropic'
AI_PROVIDER=local
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
